DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:jpg|jpeg|png|webp|gif|ico|svg)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header always set Cache-Control "public, max-age=60, stale-while-revalidate=600"
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteRule ^ja/?$ / [R=301,L]
RewriteRule ^ja/(about|pricing|gallery|access)/?$ /$1/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]
