DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(?:js|css|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:jpg|jpeg|png|webp|gif|ico|svg)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header always set Cache-Control "public, max-age=7200, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://marusauna.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP:X-Forwarded-Proto} ^$
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://marusauna.com%{REQUEST_URI} [R=301,L]
RewriteRule ^ja/?$ / [R=301,L]
RewriteRule ^ja/(about|pricing|gallery|access)/?$ /$1/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]
